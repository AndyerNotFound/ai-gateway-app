    <!-- Replace cheatsheet -->
    <string name="rp_cheat_title">Regex cheatsheet</string>
    <string name="rp_cheat_syntax_title">Syntax</string>
    <string name="rp_cheat_syntax">.        any char\n\\d \\w \\s   digit / word / whitespace\n[abc]    one of a b c\n[^abc]   not a b c\n*  +  ?   0+ , 1+ , 0 or 1\n{2,5}    2 to 5 times\n^  $      start / end of text\n(…)      capture group\na|b      a or b\n\\.       literal dot (escape)</string>
    <string name="rp_cheat_replace_title">Replacement</string>
    <string name="rp_cheat_replace">$1 $2    group 1 / 2\n$0       whole match\n(empty)  delete the match\n\\$       literal dollar sign</string>
    <string name="rp_cheat_examples_title">Examples</string>
    <string name="rp_cheat_examples">1. Mask emails\n   regex: [\\w.]+@[\\w.]+\n   to:    ***\n\n2. Swap word order\n   regex: (\\w+) (\\w+)\n   to:    $2 $1\n\n3. Strip trailing spaces\n   regex: [ \\t]+$\n   to:    (empty)\n\n4. Replace a term (case-insensitive, turn on ci)\n   regex: chatgpt\n   to:    AI\n\n5. Collapse blank lines\n   regex: \\n{3,}\n   to:    \\n\\n</string>
    <string name="rp_cheat_notes_title">Notes</string>
    <string name="rp_cheat_notes">• The model field and data: URLs are never touched.\n• Outgoing rules apply to request text, incoming to response text.\n• Streaming responses are matched per chunk, so patterns spanning chunks may not match.\n• Rules take effect after the gateway restarts.</string>

