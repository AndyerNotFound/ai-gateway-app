<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_mode"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbModeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_mode_system" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbModeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_mode_light" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbModeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_mode_dark" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="?attr/colorOutlineVariant" />

        
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDynamic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_dynamic" />
        <TextView
            android:id="@+id/textDynamicDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/theme_dynamic_desc"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        
        <TextView
            android:id="@+id/textPaletteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/theme_palette"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <RadioGroup
            android:id="@+id/paletteGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPalettePurple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_palette_purple" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPaletteBlue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_palette_blue" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPaletteGreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_palette_green" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPaletteOrange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_palette_orange" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbPaletteRed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_palette_red" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="?attr/colorOutlineVariant" />

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_language"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLangSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_language_system" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLangEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_language_en" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLangZh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_language_zh" />
        </RadioGroup>
    </LinearLayout>
</ScrollView>
